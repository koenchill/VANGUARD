          },
          "format": "table",
          "rawSql": "SELECT value FROM reporting.metric_series WHERE dashboard_id = 'mission_agent_evaluation' AND metric_id = 'faithfulness_score' ORDER BY time DESC LIMIT 1",
          "rawQuery": true
