{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OperatorAppendOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws-us-gov:s3:::vanguard-audit-worm",
        "arn:aws-us-gov:s3:::vanguard-audit-worm/*"
      ]
    },
    {
      "Sid": "DenyDeleteOnWorm",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:PutObjectLegalHold"],
      "Resource": ["arn:aws-us-gov:s3:::vanguard-audit-worm/*"]
    }
  ]
}
